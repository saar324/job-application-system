HOST=127.0.0.1
PORT=4310
JOB_SERVER_CONFIG=./config/default.json
JOB_SERVER_DATABASE=./data/state.sqlite
# Legacy JSON path is imported once when a new SQLite database is created.
JOB_SERVER_DATA=./data/state.json
JOB_SERVER_DATABASE_BUSY_TIMEOUT_MS=5000
JOB_SERVER_PROFILES_FILE=./config/profiles.json
# JSON object mapping secret tokens to fixed identities. Never commit real tokens.
# JOB_SERVER_TOKENS_JSON={"replace-with-random-token":{"actorId":"applicant-one-agent","profileId":"applicant-one","roles":["agent"]}}
JOB_SERVER_TOKENS_FILE=./data/tokens.json
# Explicit local-only escape hatch for development. Never use on a public interface.
AUTH_DISABLED=false
# Real browser/ATS automation worker. For systemd, uncomment both values below
# and set them to the same long random secret.
# APPLICATION_WEBHOOK_URL=http://127.0.0.1:4320/v1/submit
# APPLICATION_WEBHOOK_TOKEN=replace-me
# Required by Compose; used for both sides of the private server-to-worker call.
# APPLICATION_WORKER_TOKEN=replace-with-a-long-random-secret
# Browser worker for systemd (same secret as APPLICATION_WEBHOOK_TOKEN).
# WORKER_TOKEN=replace-me
# WORKER_ALLOWED_DOMAINS=boards.greenhouse.io,jobs.lever.co
# WORKER_ARTIFACTS=./data/artifacts
# WORKER_DOCUMENT_ROOT=./data/documents
# WORKER_RECEIPTS=./data/receipts
# Optional semantic enrichment. Public job text only; disabled by default.
# JOB_SEMANTIC_ENABLED=false
# JOB_SEMANTIC_ENDPOINT=https://private-model-gateway.example/v1/jobs
# JOB_SEMANTIC_TOKEN=replace-me
# JOB_SEMANTIC_MODEL=replace-me
# Optional adaptive form fallback. Keep disabled until fixture evaluation passes.
# WORKER_ADAPTIVE_ENABLED=false
# WORKER_ADAPTIVE_ENDPOINT=https://private-model-gateway.example/v1/browser
# WORKER_ADAPTIVE_TOKEN=replace-me
# WORKER_ADAPTIVE_PROFILES=applicant-one
# WORKER_ADAPTIVE_MODES=full_time
# WORKER_ADAPTIVE_DOMAINS=careers.example.com
# WORKER_ADAPTIVE_KILL_SWITCH_FILE=./data/disable-adaptive
# WORKER_ADAPTIVE_MAX_STEPS=12
# WORKER_ADAPTIVE_TIMEOUT_MS=60000
# WORKER_ADAPTIVE_MAX_TOKENS=20000
# WORKER_ADAPTIVE_MAX_COST_USD=1
# Optional constrained prose drafting. The endpoint must return JSON
# {"drafts":[{"fieldId":"...","text":"...","evidenceIds":["listing"]}]}.
# Use a separate scoped gateway token; the worker receives no general API key.
# WORKER_DRAFT_ENABLED=false
# WORKER_DRAFT_ENDPOINT=https://private-model-gateway.example/v1/application-drafts
# WORKER_DRAFT_TOKEN=replace-me
# WORKER_DRAFT_TIMEOUT_MS=20000
# API-side staging is mandatory with the webhook adapter.
# JOB_SERVER_DOCUMENT_STAGING=./data/documents
# JOB_SERVER_ALLOWED_DOCUMENT_ROOTS=/absolute/private/path/to/application-documents
# JOB_SERVER_DOCUMENT_MAX_BYTES=10485760
# JOB_SERVER_CREDENTIAL_VAULTS=./data/vaults
# JOB_SERVER_VAULT_KEYS_FILE=./data/vault-keys.json
