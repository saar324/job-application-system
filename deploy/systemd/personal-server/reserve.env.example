# Copy to /etc/job-application/reserve.env with mode 0600 and owner myos.
# Replace every value. The token must be a profile-bound agent credential.
JOB_SERVER_URL=http://127.0.0.1:4310
JOB_SERVER_TOKEN=REPLACE_WITH_PRIVATE_PROFILE_BOUND_AGENT_TOKEN
JOB_SOURCE_CATALOG=/etc/job-application/sources.json
