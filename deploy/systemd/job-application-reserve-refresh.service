[Unit]
Description=Refresh bounded job candidate reserve
After=network-online.target job-application-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=jobapp-api
Group=jobapply
WorkingDirectory=/opt/job-application-system
EnvironmentFile=/etc/job-application/reserve.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/flock -n /var/lib/job-application/reserve-refresh.lock /usr/bin/node scripts/refresh-candidate-reserve.js
TimeoutStartSec=16min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/job-application
